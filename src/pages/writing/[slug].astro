---
import { render } from 'astro:content';
import { getPublishedBlogPosts, type BlogPost } from '../../lib/content/blog';
import { formatDate, readingMinutes, orderSeries, seriesUrl } from '../../lib/content/editorial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedFollow from '../../components/FeedFollow.astro';
import { getArticleCover } from '../../lib/content/article-covers';
import { siteAssetUrl } from '../../lib/site-assets';
export async function getStaticPaths() {
  return (await getPublishedBlogPosts()).map(post => ({ params:{slug:post.slug}, props:{post} }));
}
const { post } = Astro.props as { post: BlogPost };
const { Content, headings } = await render(post);
const series = orderSeries(await getPublishedBlogPosts());
const position = series.findIndex(entry => entry.slug === post.slug);
const previous = position > 0 ? series[position - 1] : undefined;
const next = position >= 0 ? series[position + 1] : undefined;
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const canonicalUrl = new URL(`/writing/${post.slug}/`, Astro.site ?? Astro.url).toString();
const cover = getArticleCover(post.slug);
const coverUrl = cover ? siteAssetUrl(cover.src, canonicalUrl) : undefined;
const blogSchema = {
  '@context':'https://schema.org', '@type':'BlogPosting', headline:post.data.title,
  description:post.data.description, datePublished:post.data.pubDate.toISOString(),
  ...(coverUrl ? {image:coverUrl} : {}),
  ...(post.data.updatedDate ? {dateModified:post.data.updatedDate.toISOString()} : {}),
  author:{'@type':'Person',name:'Jose Flores',url:'https://0xjcf.com'}, mainEntityOfPage:canonicalUrl,
};
---
<BaseLayout title={`${post.data.title} | Jose Flores`} description={post.data.description} canonical={canonicalUrl} ogType="article" ogImage={coverUrl} ogImageAlt={cover?.alt} ogImageWidth={cover?.width} ogImageHeight={cover?.height} ogImageType={cover ? 'image/jpeg' : undefined}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(blogSchema)} />
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="writing-shell">
    <main id="main" class="writing-shell__main"><div class="container">
      <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/writing/">WRITING</a>{post.data.series && <><span>/</span><a href={seriesUrl}>{post.data.series.toUpperCase()}</a><span>/</span><span>PART {post.data.seriesOrder}</span></>}</nav>
      <article class="writing-article" id="writing-article">
        <header><h1 id="article-title">{post.data.title}</h1><p class="writing-article__summary">{post.data.description}</p><div class="article-meta"><a class="article-author" href="/about/">By Jose Flores</a><span>Published <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></span>{post.data.updatedDate && <span>Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>}<span>{readingMinutes(post)} min read</span></div></header>
        {toc.length > 0 && <details class="mobile-contents"><summary>On this page</summary><ol>{toc.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
        <div class="writing-article__content"><Content /></div>
        {post.data.glossary?.length ? <section class="writing-glossary" aria-labelledby="glossary-title"><h2 id="glossary-title">Glossary</h2><dl>{post.data.glossary.map(entry => <div class="writing-glossary__item"><dt>{entry.term}</dt><dd>{entry.definition}</dd></div>)}</dl></section> : null}
        {post.data.series && <nav class="series-pagination" aria-label="Series navigation">
          {previous ? <a href={`/writing/${previous.slug}/`}><span>← PREVIOUS / PART {previous.data.seriesOrder}</span>{previous.data.title}</a> : <a class="series-all" href={seriesUrl}><span>THE READING GUIDE</span>All essays in this series</a>}
          {next ? <a class="next" href={`/writing/${next.slug}/`}><span>NEXT / PART {next.data.seriesOrder} →</span>{next.data.title}</a> : <a class="next series-all" href={seriesUrl}><span>YOU’RE UP TO DATE</span>Back to the series →</a>}
        </nav>}
        <FeedFollow compact titleId={`subscribe-${post.slug}-title`} />
      </article>
    </div></main>
    {toc.length > 0 && <aside class="writing-shell__sidebar" aria-label="Table of contents"><nav class="writing-toc" id="writing-toc-panel"><p class="writing-toc__title">On this page</p><ol class="writing-toc__list" id="writing-toc-list">{toc.map(heading => <li class="writing-toc__item" data-depth={heading.depth}><a class="writing-toc__link" href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>)}</ol><a class="toc-series-link" href={seriesUrl}>← Behavior &amp; Boundaries<br />{post.data.seriesOrder ? `Part ${post.data.seriesOrder} of ${series.length}` : 'The reading guide'}</a></nav></aside>}
  </div>
  <script is:inline>
    (() => {
      const article = document.querySelector('.writing-article__content');
      const progress = document.querySelector('.reading-progress');
      const links = Array.from(document.querySelectorAll('[data-toc-link]'));
      const headings = Array.from(article?.querySelectorAll('h2[id],h3[id]') || []);
      let queued = false;
      const update = () => {
        queued = false;
        const total = document.documentElement.scrollHeight - innerHeight;
        if (progress) progress.style.width = `${total > 0 ? Math.min(100, scrollY / total * 100) : 0}%`;
        let active = headings[0]?.id;
        for (const heading of headings) if (heading.getBoundingClientRect().top <= innerHeight * .3) active = heading.id;
        for (const link of links) {
          if (link.dataset.tocLink === active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      };
      addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, {passive:true});
      addEventListener('resize', update);
      document.querySelector('.mobile-contents')?.addEventListener('click', event => {
        if (event.target.closest('a')) event.currentTarget.open = false;
      });
      update();
    })();
  </script>
</BaseLayout>
