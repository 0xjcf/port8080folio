---
import BaseLayout from './BaseLayout.astro';
const { title, description, bodyClass = 'status-page', noindex = true } = Astro.props;
const isNewsletter = Astro.url.pathname.startsWith('/newsletter-');
---
<BaseLayout title={title} description={description} bodyClass={bodyClass} noindex={noindex}>
  <main id="main" class="status-page__wrapper">
    {isNewsletter && <p class="legacy-notice">This is a response page from the earlier email signup flow. Email signup is currently paused. You can <a href="/rss.xml">follow new writing via RSS</a>.</p>}
    <slot />
  </main>
</BaseLayout>
